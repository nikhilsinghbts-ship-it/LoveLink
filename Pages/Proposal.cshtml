@page
@model LoveLink.Pages.ProposalModel
@{
    ViewData["Title"] = "A Special Surprise ❤️";
}

@if (Model.Proposal == null)
{
    <div class="not-found">
        <h1>😔 Proposal Not Found</h1>
        <p>This link may be invalid or the proposal is no longer available.</p>
        <a href="/" class="back-home">← Back to LoveLink</a>
    </div>
}
else
{
    <div class="proposal-page">

        <!-- PASSWORD SCREEN -->
        <div id="passwordScreen" class="password-screen">

            <div class="lock-heart">🔐❤️</div>

            <div class="mini-stars">✦ ✧ ✦ ✧ ✦</div>

            <h1>A Secret Surprise Awaits</h1>

            <p>
                Something special has been created just for
                <strong>@Model.Proposal.RecipientName</strong> ❤️
            </p>

            <form id="passwordForm">

                <div class="password-input-wrap">
                    <span>🔑</span>

                    <input type="password"
                           id="passwordInput"
                           placeholder="Enter your secret password"
                           autocomplete="off" />
                </div>

                <p id="errorMessage" class="password-error"></p>

                <button type="submit" class="unlock-btn">
                    🔓 Unlock My Surprise
                </button>

            </form>

            <div class="secret-note">
                ✨ A little secret is waiting behind this lock ✨
            </div>

        </div>


        <!-- UNLOCK ANIMATION -->
        <div id="unlockAnimation" class="unlock-animation hidden">

            <div class="magic-circle">
                <div class="unlock-lock">🔓</div>
            </div>

            <h1>Unlocking your surprise...</h1>

            <p>Something beautiful is about to begin ❤️</p>

            <div class="unlock-hearts">
                ❤️ 💕 💖 💗 💓 💞 ❤️
            </div>

        </div>


        <!-- ENVELOPE SCREEN -->
        <div id="envelopeScreen" class="envelope-screen hidden">

            <div class="magic-hearts">
                ✦ ❤️ ✦ 💕 ✦ 💖 ✦ ❤️ ✦
            </div>

            <span class="little-label">A MESSAGE FOR YOU</span>

            <h1>Just For You... ❤️</h1>

            <p class="envelope-subtitle">
                Someone has something special to tell you.
            </p>

            <div id="envelope" class="envelope">

                <div class="envelope-glow"></div>

                <div class="envelope-back"></div>

                <div class="envelope-letter-preview">

                    <div class="preview-heart">💌</div>

                    <p>Open me...</p>

                </div>

                <div class="envelope-flap"></div>

                <div class="envelope-front"></div>

                <div class="heart-seal">
                    ❤️
                </div>

            </div>

            <p class="click-envelope">
                👆 Tap the envelope to open your heart
            </p>

        </div>


        <!-- FULL LETTER -->
        <div id="letterScreen" class="letter-screen hidden">

            <div class="falling-hearts">
                <span>❤️</span>
                <span>💕</span>
                <span>💖</span>
                <span>💗</span>
                <span>💓</span>
                <span>💞</span>
                <span>❤️</span>
                <span>💕</span>
            </div>

            <div class="letter-box">

                <div class="letter-top-decoration">
                    ✦ ───── ❤️ ───── ✦
                </div>

                <div class="heart-big">
                    ❤️
                </div>

                <div class="letter-label">
                    A LETTER FROM THE HEART
                </div>

                <h1>@Model.Proposal.Title</h1>

                <div class="dear-line">
                    Dear <strong>@Model.Proposal.RecipientName</strong> ❤️
                </div>

                <div class="letter-divider">
                    ♡
                </div>

                <div class="letter-text">
                    @Model.Proposal.Letter
                </div>

                <div class="letter-divider">
                    ♡
                </div>

                <p class="from-name">
                    With all my heart,<br />
                    <strong>@Model.Proposal.YourName ❤️</strong>
                </p>


                <!-- QUESTION -->
                <div class="question-box">

                    <div class="question-heart">
                        💖
                    </div>

                    <p class="question-small">
                        And now... I have one little question
                    </p>

                    <h2>
                        Will You Be Mine Forever? ❤️
                    </h2>

                    <p class="question-subtitle">
                        No pressure... just follow your heart. 🥹💕
                    </p>

                    <div class="proposal-buttons">

                        <button id="yesButton" class="yes-btn">
                            <span>YES</span> ❤️
                        </button>

                        <button id="noButton" class="no-btn">
                            Maybe... 🙈
                        </button>

                    </div>

                </div>

            </div>


            <!-- CELEBRATION -->
            <div id="successMessage" class="success-message hidden">

                <div class="celebration">
                    🎉 💖 ✨ ❤️ ✨ 💖 🎉
                </div>

                <div class="success-heart">
                    💕
                </div>

                <h1>YAYYYY! ❤️</h1>

                <h2>
                    You just made two hearts very happy! 🥹
                </h2>

                <p>
                    This is the beginning of something beautiful.
                    May your journey together be filled with
                    love, laughter, happiness and countless
                    unforgettable memories. 💕
                </p>

                <div class="love-forever">
                    ❤️ Together is my favourite place to be ❤️
                </div>

                <div class="big-hearts">
                    💖 💕 💗 💓 💕 💖
                </div>

            </div>


            <a href="/Create" class="create-own">
                💌 Create Your Own Love Story
            </a>

        </div>

    </div>


    <script>

        const correctPassword = "@Model.Proposal.Password";

        const passwordForm =
            document.getElementById("passwordForm");

        passwordForm.addEventListener("submit", function (event) {

            event.preventDefault();

            const enteredPassword =
                document.getElementById("passwordInput").value;

            const errorMessage =
                document.getElementById("errorMessage");

            if (enteredPassword === correctPassword) {

                errorMessage.textContent = "";

                document.getElementById("passwordScreen")
                    .classList.add("hidden");

                document.getElementById("unlockAnimation")
                    .classList.remove("hidden");

                setTimeout(function () {

                    document.getElementById("unlockAnimation")
                        .classList.add("hidden");

                    document.getElementById("envelopeScreen")
                        .classList.remove("hidden");

                }, 3000);

            }
            else {

                errorMessage.textContent =
                    "❌ That's not the secret password... try again ❤️";

                document.getElementById("passwordInput")
                    .classList.add("shake");

                setTimeout(function () {

                    document.getElementById("passwordInput")
                        .classList.remove("shake");

                }, 500);

            }

        });


        // OPEN ENVELOPE

        document.getElementById("envelope")
            .addEventListener("click", function () {

                const envelope =
                    document.getElementById("envelope");

                envelope.classList.add("opening");

                setTimeout(function () {

                    document.getElementById("envelopeScreen")
                        .classList.add("hidden");

                    document.getElementById("letterScreen")
                        .classList.remove("hidden");

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });

                }, 1600);

            });


        // YES BUTTON

        document.getElementById("yesButton")
            .addEventListener("click", function () {

                document.getElementById("successMessage")
                    .classList.remove("hidden");

                createHeartExplosion();

                setTimeout(function () {

                    document.getElementById("successMessage")
                        .scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                }, 100);

            });


        // RUNNING / SHY NO BUTTON

        const noButton =
            document.getElementById("noButton");

        const noMessages = [
            "Maybe... 🙈",
            "Are you sure? 🥺",
            "Think again ❤️",
            "Don't break my heart 😭",
            "Give love a chance 💕",
            "Really? 🥹",
            "One more thought? 💖"
        ];

        let noCount = 0;

        noButton.addEventListener("mouseenter", function () {

            if (window.innerWidth > 600) {

                const randomX =
                    Math.floor(Math.random() * 260) - 130;

                const randomY =
                    Math.floor(Math.random() * 160) - 80;

                noButton.style.transform =
                    `translate(${randomX}px, ${randomY}px)`;

                noButton.textContent =
                    noMessages[noCount % noMessages.length];

                noCount++;
            }

        });


        noButton.addEventListener("click", function () {

            if (window.innerWidth <= 600) {

                noButton.textContent =
                    noMessages[noCount % noMessages.length];

                noCount++;

            }

        });


        // HEART EXPLOSION

        function createHeartExplosion() {

            const hearts = [
                "❤️",
                "💕",
                "💖",
                "💗",
                "💓",
                "💞",
                "✨"
            ];

            for (let i = 0; i < 45; i++) {

                const heart =
                    document.createElement("div");

                heart.className =
                    "explosion-heart";

                heart.textContent =
                    hearts[Math.floor(Math.random() * hearts.length)];

                heart.style.left =
                    "50%";

                heart.style.top =
                    "50%";

                heart.style.setProperty(
                    "--x",
                    (Math.random() * 700 - 350) + "px"
                );

                heart.style.setProperty(
                    "--y",
                    (Math.random() * 700 - 350) + "px"
                );

                heart.style.animationDelay =
                    (Math.random() * 0.5) + "s";

                document.body.appendChild(heart);

                setTimeout(function () {
                    heart.remove();
                }, 3000);

            }

        }

    </script>
}