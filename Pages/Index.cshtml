@page
@model IndexModel
@{
    ViewData["Title"] = "LoveLink";
}

<div class="hero">

    <div class="hearts">❤️ 💕 💖 💗 ❤️</div>

    <h1>LoveLink ❤️</h1>

    <h2>Create Something Special for Someone Special</h2>

    <p>
        Write your own romantic message, protect it with a secret password,
        and share your unique surprise link with someone you love.
    </p>

    <div class="buttons">
        <a href="/Create" class="btn create-btn">
            ❤️ Create a Proposal
        </a>

        <a href="#open" class="btn open-btn">
            🔐 Open a Secret Proposal
        </a>
    </div>

    <div class="features">
        <div class="feature">
            💌
            <h3>Write</h3>
            <p>Create your personal message.</p>
        </div>

        <div class="feature">
            🔐
            <h3>Protect</h3>
            <p>Set a secret password.</p>
        </div>

        <div class="feature">
            🔗
            <h3>Share</h3>
            <p>Send your unique link.</p>
        </div>
    </div>

</div>